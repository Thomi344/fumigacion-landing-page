---
// =================================================
// ============ Secction de "Opiniones" ============
// =================================================
const reviews = [
  {
    nombre: "Mariana G.",
    tiempo: "Hace 1 semana",
    texto: "Excelente servicio. Vinieron a mi casa en el día, sacaron todas las cucarachas y el perro ni se enteró porque el producto es pet-friendly. Súper recomendables.",
    inicial: "M"
  },
  {
    nombre: "Carlos M.",
    tiempo: "Hace 2 semanas",
    texto: "Llamamos por un problema de ratas en el consorcio. Muy profesionales, pusieron cebos seguros y no volvimos a tener problemas. 100% efectivos.",
    inicial: "C"
  },
  {
    nombre: "Laura S.",
    tiempo: "Hace 1 mes",
    texto: "Presupuesto claro por WhatsApp y llegaron a la hora acordada. Fumigaron contra el dengue en el jardín. Muy amables y prolijos para trabajar.",
    inicial: "L"
  },
  {
    nombre: "Diego F.",
    tiempo: "Hace 3 semanas",
    texto: "Los contacté de urgencia un domingo y vinieron. Nos explicaron todo el proceso. Nos dio mucha tranquilidad saber que a las 2 horas podíamos volver a entrar.",
    inicial: "D"
  },
  {
    nombre: "Romina P.",
    tiempo: "Hace 1 mes",
    texto: "Tenía chinches en la pieza y estaba desesperada. En una sesión lo resolvieron y me explicaron cómo prevenir. Un alivio total.",
    inicial: "R"
  },
  {
    nombre: "Javier T.",
    tiempo: "Hace 2 meses",
    texto: "Muy buena atención. Lo mejor es que el producto casi no tenía olor, y no tuvimos que vaciar la cocina entera como nos habían dicho en otro lado.",
    inicial: "J"
  },
  {
    nombre: "Gastón R.",
    tiempo: "Hace 1 semana",
    texto: "Trabajo impecable en mi local gastronómico. Me dejaron el certificado para la municipalidad en el momento y todo en regla. Excelente servicio para comercios.",
    inicial: "G"
  },
  {
    nombre: "Silvina L.",
    tiempo: "Hace 2 meses",
    texto: "Eficacia total contra las hormigas que me estaban comiendo las plantas. Súper respetuosos, limpios para trabajar y cumplieron con la garantía.",
    inicial: "S"
  },
  {
    nombre: "Martín V.",
    tiempo: "Hace 3 meses",
    texto: "Se nota que saben lo que hacen. Revisaron todos los rincones, encontraron el nido y lo solucionaron de raíz. Precio acorde al servicio premium que dan.",
    inicial: "M"
  },
  {
    nombre: "Roberto C.",
    tiempo: "Hace 2 semanas",
    texto: "Es la segunda vez que los llamo para mantenimiento preventivo en mi galpón. Siempre impecables, rápidos y con presupuesto sin cargo.",
    inicial: "R"
  }
];

// Duplicamos el array para que el efecto de scroll infinito sea perfecto y no pegue saltos -------->
const duplicatedReviews = [...reviews, ...reviews];

// <-------- Generamos el Schema para Google -------->
const aggregateRatingSchema = {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Fumigación Buenos Aires", // <-------- O tu variable companyName -------->
    "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "5.0",
        "reviewCount": reviews.length.toString(),
        "bestRating": "5",
        "worstRating": "1"
    },
    "review": reviews.map(r => ({
        "@type": "Review",
        "author": {
        "@type": "Person",
        "name": r.nombre
        },
        "reviewBody": r.texto,
        "reviewRating": {
        "@type": "Rating",
        "ratingValue": "5"
        }
    }))
};
---

<section id="opiniones" class="w-full py-20 bg-[#0f172b] overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 lg:px-12 mb-12 flex flex-col md:flex-row items-center justify-between gap-6 text-center md:text-left">
    
    <div>
      <h2 class="text-3xl md:text-5xl font-extrabold text-white tracking-tight">
        Lo que dicen <span class="text-[var(--color-marca)]">nuestros clientes</span>
      </h2>
      <p class="mt-3 text-slate-400 text-lg">
        Garantía de satisfacción avalada por quienes ya nos eligieron.
      </p>
    </div>

    {/* <-------- Insignia de Google */}
    <div class="flex items-center gap-3 bg-white/10 px-5 py-3 rounded-2xl border border-white/10 backdrop-blur-sm">
      <div class="flex gap-1">
        {[1, 2, 3, 4, 5].map(() => (
          <svg class="w-5 h-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
        ))}
      </div>
      <span class="text-white font-bold text-lg">5.0</span>
      <svg class="w-6 h-6" viewBox="0 0 24 24">
        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
      </svg>
    </div>
  </div>

  {/* <-------- Contenedor del Carrusel -------->*/}
  <div class="relative flex overflow-x-hidden group">
    
    {/* <-------- Gradientes laterales para dar efecto de que las tarjetas "aparecen" y "desaparecen" en las puntas -------->*/}
    <div class="absolute top-0 bottom-0 left-0 w-12 md:w-32 bg-gradient-to-r from-[#0f172b] to-transparent z-10 pointer-events-none"></div>
    <div class="absolute top-0 bottom-0 right-0 w-12 md:w-32 bg-gradient-to-l from-[#0f172b] to-transparent z-10 pointer-events-none"></div>

    {/* <-------- La pista que se mueve (track) -------->*/}
    <div class="animate-marquee flex gap-6 px-3">
      {duplicatedReviews.map((review) => (
        <div class="w-[300px] md:w-[380px] flex-shrink-0 bg-white p-6 rounded-2xl shadow-lg border border-slate-100 flex flex-col h-full transform transition-transform duration-300 hover:scale-[1.02]">
          
          {/* <-------- Cabecera de la reseña: Foto, Nombre, Tiempo -------->*/}
          <div class="flex items-center gap-4 mb-4">
            <div class="w-12 h-12 rounded-full bg-[var(--color-marca)] flex items-center justify-center text-white font-bold text-xl flex-shrink-0">
              {review.inicial}
            </div>
            <div>
              <h3 class="font-bold text-slate-900 leading-tight">{review.nombre}</h3>
              <p class="text-sm text-slate-500">{review.tiempo}</p>
            </div>
            {/* <-------- Ícono de Google chiquito en la esquina de cada tarjeta -------->*/}
            <svg class="w-5 h-5 ml-auto opacity-70" viewBox="0 0 24 24">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
              <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
            </svg>
          </div>

          {/* <-------- Estrellas de la reseña -------->*/}
          <div class="flex gap-1 mb-3">
            {[1, 2, 3, 4, 5].map(() => (
              <svg class="w-4 h-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>

          {/* <-------- Texto de la reseña -------->*/}
          <p class="text-slate-600 leading-relaxed italic flex-grow">
            "{review.texto}"
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
<script type="application/ld+json" set:html={JSON.stringify(aggregateRatingSchema)} />

<style>
  /* <-------- Animación CSS para el scroll infinito -------->*/
  .animate-marquee {
    /* <-------- Ajustá los '45s' para hacerlo más rápido o más lento -------->*/
    animation: marquee 45s linear infinite;
    width: max-content;
  }

  /* <-------- Si el usuario pasa el mouse, la animación se pausa para poder leer -------->*/
  .group:hover .animate-marquee {
    animation-play-state: paused;
  }

  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      /* <-------- Se desplaza exactamente la mitad (porque el array está duplicado), generando un loop perfecto -------->*/
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
  .animate-marquee {
    animation: none;
    overflow-x: auto;
  }
}
</style>
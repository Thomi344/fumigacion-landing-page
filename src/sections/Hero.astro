---
// ============================================
// ============ Secction de "Hero" ============
// ============================================
import { Image } from 'astro:assets'; // <-------- 1. Importamos Image de Astro -------->
import Button from '../components/Button.astro';
import imgHero from '../assets/servicios/Hero.webp';

// <-------- 2. Actualizamos la interface para recibir los datos directo de [zona].astro -------->
interface Props {
  nombreZona?: string;
  region?: string;
  barrios?: string[];
}

const { 
  nombreZona = 'Buenos Aires', 
  region = 'CABA y GBA', 
  barrios = [] 
} = Astro.props;

const phone = import.meta.env.PUBLIC_PHONE?.replace('+', '') || '541100000000';
const companyName = import.meta.env.PUBLIC_COMPANY_NAME || 'Fumigaciones Alta Eficiencia';

// <-------- 3. Armamos el texto SEO dinámico usando el array de barrios inyectado -------->
const seoBarrios = barrios.length > 0 
  ? ` Atendemos de forma inmediata en los barrios de ${barrios.slice(0, 5).join(', ')} y alrededores.`
  : ` Brindamos cobertura integral con atención inmediata en toda la zona de ${region}.`;

const msgWpp = `https://wa.me/${phone}?text=Hola%20${companyName.replace(/\s/g, '%20')},%20necesito%20un%20presupuesto%20para%20fumigaci%C3%B3n%20en%20${nombreZona}.`;
---

<section id="hero" class="relative w-full min-h-[90vh] flex items-center px-5 pt-32 pb-20 md:pl-[50px] lg:pl-[120px] overflow-hidden bg-slate-950">
  
  {/* <-------- 4. Imagen de fondo optimizada (dejé un solo loading="eager" para que no se duplique) --------> */}
  <Image 
    src={imgHero}
    alt={`Servicio de fumigación en ${nombreZona}`}
    loading="eager"          
    fetchpriority="high"      
    decoding="async"
    width={1920}
    height={1080}
    class="absolute inset-0 z-0 w-full h-full object-cover object-[80%_center] md:object-center transition-opacity duration-700"
  />
  
  <div class="absolute inset-0 z-0 bg-gradient-to-r from-black/90 via-black/70 to-black/40 md:from-black/80 md:to-transparent"></div>

  <div class="relative z-10 w-full max-w-5xl mr-auto flex flex-col items-center text-center md:items-start md:text-left">
    
    <header class="flex flex-col gap-1 mb-6">
      <p class="text-[var(--color-marca)] font-bold uppercase tracking-widest text-sm md:text-base">
        Empresa de Fumigación y Sanitización
      </p>
      
      <h1 class="text-4xl md:text-6xl lg:text-7xl font-extrabold text-white tracking-tight leading-[1.1] text-balance">
        Especialistas en <br class="hidden md:block" /> 
        Control de Plagas en <span class="text-[var(--color-marca)]">{nombreZona}</span>
      </h1>
    </header>

    <div class="flex flex-col gap-6 max-w-3xl">
      <p class="text-lg md:text-xl lg:text-2xl text-white font-medium leading-relaxed text-pretty">
        Eliminamos de raíz <span class="text-[var(--color-marca)]">cucarachas, roedores, hormigas, chinches, pulgas</span> y todo tipo de insectos molestos. Utilizamos métodos seguros, sin olores fuertes, ideales para proteger tu hogar, comercio, consorcio o industria con garantía de satisfacción.
      </p>

      <p class="text-base md:text-lg text-gray-300 leading-relaxed border-l-2 border-[var(--color-marca)] pl-4">
        <strong>Trabajamos en {nombreZona} y zonas aledañas.</strong> 
        {seoBarrios}
      </p>
    </div>

    <div class="flex flex-col sm:flex-row gap-4 mt-10 w-full sm:w-auto">
      {/* <-------- 5. Corrección de comillas en los atributos de este botón --------> */}
      <Button 
        href={msgWpp} 
        target="_blank" 
        rel="noopener noreferrer" 
        variant="primary"
        class="shadow-2xl shadow-[var(--color-marca)]/20"
        aria-label={`Solicitar presupuesto de fumigación en ${nombreZona} por WhatsApp`}
      >
        Pedir presupuesto ya
      </Button>
      
      <Button 
        href="#servicios"
        rel="noopener noreferrer" 
        variant="outline"
      >
        Ver Servicios
      </Button>
    </div>

  </div>
</section>

<style>
  h1 {
    text-wrap: balance;
  }
</style>
---
// ==========================================
// ============ Layout general  ============
// ==========================================
import { zonas } from '../data/data.js';
import WhatsappFlotante from '../components/WhatsappFlotante.astro';

interface Props {
    title?: string;
    description?: string;
}

// <-------- Desestructuramos props -------->
const { 
    title = "Fumigación Buenos Aires | Control de Plagas en GBA y CABA",
    description = "Expertos en fumigación y control de plagas para hogares y comercios. Eliminación definitiva de cucarachas, roedores e insectos. Servicio rápido, seguro y con garantía."
} = Astro.props;

// <-------- Variables y Configuración -------->
const gtmId = import.meta.env.PUBLIC_GTM_ID;
const phone = import.meta.env.PUBLIC_PHONE;
const companyName = import.meta.env.PUBLIC_COMPANY_NAME || "Fumigación Buenos Aires";
const ogImage = import.meta.env.PUBLIC_OG_IMAGE || "/og-image.webp";

// <-------- Construcción correcta de URLs con Astro.site -------->
// Esto evita problemas de barras al final (trailing slash) y discrepancias canónicas
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const fullOgImage = new URL(ogImage, Astro.site).toString();

// <-------- Aplanamos barrios para SEO Local -------->
const todosLosBarrios = zonas.flatMap(zona => zona.barrios);

// <-------- Schema.org para PestControlService -------->
const localBusinessSchema = {
    "@context": "https://schema.org",
    "@type": ["LocalBusiness", "PestControlService"],
    "name": companyName,
    "url": Astro.site ? Astro.site.toString() : "",
    "telephone": phone,
    "image": new URL("/images/logo.webp", Astro.site || "https://xn--fumigacines-buenosaires-djc.com.ar").toString(),
    "description": description,
    "address": {
        "@type": "PostalAddress",
        "addressLocality": "Buenos Aires",
        "addressRegion": "CABA y GBA",
        "addressCountry": "AR"
    },
    "areaServed": todosLosBarrios.map(barrio => ({
        "@type": "City",
        "name": barrio
    })),
    "priceRange": "$$",
    "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": 4.9,
        "reviewCount": 84,
        "bestRating": 5,
        "worstRating": 1
    }
};
---

<!doctype html>
<html lang="es-AR" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        
        <title>{title === "Fumigación Buenos Aires | Control de Plagas en GBA y CABA | ¡Cotizá ahora!" ? title : `${title} | ${companyName}`}</title>
        
        <meta name="description" content={description} />
        
        <!-- URL Canónica corregida -->
        <link rel="canonical" href={canonicalURL} />
        
        <meta name="generator" content={Astro.generator} />

        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
        <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
        <link rel="manifest" href="/site.webmanifest">
            
        <meta name="theme-color" content="#ffffff" />

        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={fullOgImage} />
        
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={fullOgImage} />

        <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />

		<script is:inline define:vars={{ gtmId }}>
				if (gtmId && gtmId !== 'GTM-XXXXXXX') {
					(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
					new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
					j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
					'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
					})(window,document,'script','dataLayer', gtmId);
				}
		</script>
    </head>
    <body class="bg-[var(--color-fondo-base)] text-[var(--color-texto-principal)] antialiased selection:bg-[var(--color-marca)] selection:text-white">
        {gtmId && (
            <noscript>
                <iframe src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
                height="0" width="0" style="display:none;visibility:hidden"></iframe>
            </noscript>
        )}      
        
        <main>
            <slot />
        </main>

        <WhatsappFlotante/>
    </body>
</html>
<style is:global>
	/* <-------- Optimizamos la carga de Tailwind --------> */
	@import 'tailwindcss';

	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100vh;
		/* <-------- Suavizamos el renderizado de fuentes para mejorar el Speed Index -------->*/
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
		text-rendering: optimizeLegibility;
		scroll-behavior: smooth;
	}

	@theme {
		/* <-------- Colores extraídos y adaptados del logo para un diseño limpio y blanco -------->*/
		--color-marca: #098f32;         /* <-------- Verde vivo, intenso  -------->*/
        --color-marca-hover: #077a2a;   /* <-------- Oscurece un poco al pasar el mouse -------->*/
        --color-marca-suave: #e6f7ec;   /* <-------- Para fondos muy tenues */	
		
		--color-wpp: #25D366;           /* <-------- Verde oficial de WhatsApp -------->*/
		--color-wpp-hover: #128C7E;     
		
		--color-fondo-base: #ffffff;    /* <-------- Página blanca  -------->*/
		--color-fondo-nav: #ffffff;  	/* <-------- Navegación blanca */
		--color-fondo-card: #fafafa;    /* <-------- Un gris/blanco apenas distinto para diferenciar tarjetas -------->*/
		
		--color-borde: #e5e7eb;         /* <-------- Gris claro para divisores sutiles */
		--color-texto-principal: #111827; /* <-------- Negro/Gris muy oscuro para legibilidad (como el texto del logo) -------->*/
		--color-texto-secundario: #4b5563; /* <-------- Gris medio para descripciones -------->*/
	}
</style>
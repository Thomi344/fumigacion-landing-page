---
// ===============================================
// ============ Componente del Footer ============
// ===============================================

const companyName = import.meta.env.PUBLIC_COMPANY_NAME || 'Fumigaciones Alta Eficiencia';
const phone = import.meta.env.PUBLIC_PHONE?.replace('+', '') || '1140235795';
const facebookLink = "https://www.facebook.com/profile.php?id=61587302104382";
const instagramLink = "https://www.instagram.com/fumigacion_buenosaires/";

const enlacesRapidos = [
  { nombre: 'Inicio', url: '#hero' },
  { nombre: 'Servicios', url: '#servicios' },
  { nombre: 'Cómo Trabajamos', url: '#metodo' },
  { nombre: 'Preguntas Frecuentes', url: '#faq' }
];

// <-------- Regiones principales agrupadas para un diseño de Footer más limpio -------->
const regionesPrincipales = [
    { nombre: "Capital Federal (CABA)" },
    { nombre: "Zona Sur GBA" },
    { nombre: "Zona Norte GBA" },
    { nombre: "Zona Oeste GBA" },
    { nombre: "Ezeiza y alrededores" }
];
---

<footer class="w-full bg-[#0f172b] text-slate-300 py-16 border-t border-slate-800/50">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 lg:gap-8">
      
      {/* <-------- Columna 1: Marca, Descripción y bloque NAP --------> */}
      <div class="md:col-span-4 flex flex-col gap-6">
        <p class="text-2xl font-black text-white tracking-tight">
          {companyName}
        </p>
        
        <p class="text-slate-400 leading-relaxed text-pretty">
          Soluciones profesionales en control de plagas. Protegemos tu hogar y tu negocio con métodos seguros y certificados.
        </p>

        {/* <-------- Bloque NAP para SEO Local --------> */}
        <div class="space-y-2 text-sm">
          <p class="flex items-center gap-2">
            <svg class="w-4 h-4 text-[var(--color-marca)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span class="text-slate-400">Cobertura en CABA y GBA</span>
          </p>
          <p class="flex items-center gap-2">
            <svg class="w-4 h-4 text-[var(--color-marca)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span class="text-slate-400">Urgencias: {phone}</span>
          </p>
        </div>
        
        {/* <-------- Redes Sociales --------> */}
        <div class="flex flex-col gap-2 mt-2">
            <p class="text-xs uppercase tracking-widest text-[var(--color-marca)] font-bold">Atención 24hs</p>
            <div class="flex items-center gap-4">
                <a href={`https://wa.me/${phone}`} target="_blank" rel="noopener noreferrer" aria-label="Contactar por WhatsApp" class="w-11 h-11 rounded-full bg-slate-800 flex items-center justify-center text-white hover:bg-[var(--color-wpp)] hover:scale-110 transition-all duration-300 shadow-lg">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
                </a>
                <a href={instagramLink} target="_blank" rel="noopener noreferrer" aria-label="Seguir en Instagram" class="w-11 h-11 rounded-full bg-slate-800 flex items-center justify-center text-white hover:bg-pink-600 hover:scale-110 transition-all duration-300 shadow-lg">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                </a>
                <a href={facebookLink} target="_blank" rel="noopener noreferrer" class="w-11 h-11 rounded-full bg-slate-800 flex items-center justify-center text-white hover:bg-blue-600 hover:scale-110 transition-all duration-300 shadow-lg" aria-label="Facebook">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M22.675 0h-21.35c-.732 0-1.325.593-1.325 1.325v21.351c0 .731.593 1.324 1.325 1.324h11.495v-9.294h-3.128v-3.622h3.128v-2.671c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12v9.293h6.116c.73 0 1.323-.593 1.323-1.325v-21.35c0-.732-.593-1.325-1.325-1.325z"/>
                    </svg>
            </a>
          </div>
        </div>
      </div>

      {/* <-------- Columna 2: Enlaces Rápidos --------> */}
      <div class="md:col-span-3">
        <p class="text-white font-bold text-lg mb-6 tracking-wide">Accesos Rápidos</p>
        <ul class="space-y-4">
          {enlacesRapidos.map((link) => (
            <li>
              <a href={link.url} class="text-slate-400 hover:text-[var(--color-marca)] transition-all duration-300 flex items-center gap-3 group">
                <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-marca)] opacity-50 group-hover:opacity-100 transition-opacity"></span>
                {link.nombre}
              </a>
            </li>
          ))}
        </ul>
      </div>

      {/* <-------- Columna 3: Directorio de Zonas (Como en Cerrajería) --------> */}
      <div class="md:col-span-5">
        <p class="text-white font-bold text-lg mb-6 uppercase tracking-wider text-sm">Zonas de Atención</p>
        
        <ul class="space-y-4 mb-8">
            {regionesPrincipales.map((region) => (
                <li class="flex items-center gap-3 text-slate-300 hover:text-white transition-colors">
                    <svg class="w-4 h-4 text-slate-500" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                        <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
                    </svg>
                    <span>{region.nombre}</span>
                </li>
            ))}
        </ul>

        {/* <-------- Link al Directorio Programático --------> */}
        <div class="border-t border-slate-800 pt-6">
            <a href="/zonas-de-cobertura/" class="inline-flex items-center gap-2 text-[var(--color-marca)] font-bold hover:text-[var(--color-marca-hover)] transition-colors uppercase tracking-wider text-sm group">
                Ver Directorio de Zonas
                <span class="transform group-hover:translate-x-1 transition-transform">→</span>
            </a>
        </div>
      </div>

    </div>

    <div class="mt-16 pt-8 border-t border-slate-800/50 flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-slate-500">
      <p>&copy; {new Date().getFullYear()} {companyName}.</p>
      <p>Desarrollado con Astro 🚀 para mayor velocidad.</p>
    </div>

  </div>
</footer>
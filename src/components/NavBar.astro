---
// ================================
// ============ NavBar ============
// ================================

import { zonas } from '../data/data.js';
import Button from './Button.astro'; //<-------- Importamos el nuevo botón -------->

const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://xn--fumigacines-buenosaires-djc.com.ar';
const phone = import.meta.env.PUBLIC_PHONE || "+5491100000000";
const cleanPhone = phone.replace(/\D/g, '');
const wppMessage = encodeURIComponent("Hola, necesito fumigación de plagas. ¿Me podrían asesorar?");
const wppLink = `https://wa.me/${cleanPhone}?text=${wppMessage}`;

// ---- LÓGICA DE UBICACIÓN DINÁMICA -------->
const currentPath = Astro.url.pathname;
let ubicacionActual = "CABA y GBA"; // <-------- Ubicación por defecto para la Home -------->

// <-------- Buscamos si la URL actual contiene el slug de alguna de tus zonas -------->
const zonaEncontrada = zonas.find(zona => currentPath.includes(zona.slug));
if (zonaEncontrada) {
  ubicacionActual = zonaEncontrada.nombre;
}
---

<header class="bg-[var(--color-fondo-nav)] border-b border-[var(--color-borde)] fixed w-full top-0 z-50 h-24 flex items-center shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full flex justify-between items-center">
    
    {/*<-------- Logo y Marca -------->*/}
    <a href={siteUrl} class="flex items-center gap-3 group" aria-label="Inicio - Fumigación Buenos Aires">
      <div class="text-[var(--color-marca)] transition-transform duration-300 group-hover:scale-110">
        <svg xmlns="http://www.w3.org/2000/svg" width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <path d="m12 12 4-4"/>
          <path d="M16 12l-4-4"/>
          <path d="M8 12h8"/>
          <circle cx="12" cy="12" r="2"/>
        </svg>
      </div>
      
      <div class="flex flex-col leading-none">
        <div class="text-xl md:text-3xl font-black uppercase tracking-tighter">
          <span class="text-[var(--color-texto-principal)]">Fumigación</span>
          <span class="text-[var(--color-marca)]">Buenos Aires</span>
        </div>
        <span class="text-sm md:text-base font-bold text-[var(--color-texto-secundario)] tracking-wide mt-1 group-hover:text-[var(--color-texto-principal)] transition-colors">
            Servicio en <span class="text-[var(--color-marca)]">{ubicacionActual}</span>
        </span>
      </div>
    </a>

    {/* <-------- Navegación y Botón en PC  -------->*/}
    <div class="hidden md:flex items-center gap-8">
      {/* <-------- Enlaces de Navegación PC  -------->*/}
      <nav class="flex items-center gap-6 text-[var(--color-texto-principal)] font-semibold text-sm uppercase tracking-wide">
        <a href="#hero" class="hover:text-[var(--color-marca)] transition-colors">Inicio</a>
        <a href="#servicios" class="hover:text-[var(--color-marca)] transition-colors">Servicios</a>
        <a href="#metodo" class="hover:text-[var(--color-marca)] transition-colors">Cómo Trabajamos</a>
        <a href="#faq" class="hover:text-[var(--color-marca)] transition-colors">FAQ</a>
      </nav>

      {/* <-------- Botón CTA PC -------->*/}
      <Button href={wppLink} variant="primary" target="_blank" rel="noopener noreferrer">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
        CONTACTAR AHORA
      </Button>
    </div>

    {/* <--------Botón Hamburguesa Móvil -------->*/}
    <button id="mobile-menu-btn" class="md:hidden p-2 text-[var(--color-texto-principal)] focus:outline-none focus:ring-2 focus:ring-[var(--color-marca)] rounded-md" aria-label="Abrir menú">
      <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
      <svg id="icon-close" class="hidden" xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>
  </div>

  {/* <-------- Menú Desplegable Móvil -------->*/}
  <div id="mobile-menu" class="absolute top-24 left-0 w-full bg-[var(--color-fondo-nav)] border-b border-[var(--color-borde)] shadow-lg hidden flex-col md:hidden pb-4">
    <nav class="flex flex-col text-lg font-bold text-[var(--color-texto-principal)] py-6 px-6 gap-6">
      
      {/* <-------- Enlaces de Navegación Móvil -------->*/}
      <div class="flex flex-col gap-5 border-b border-[var(--color-borde)] pb-6 mb-2">
        <a href="#hero" class="mobile-link hover:text-[var(--color-marca)] transition-colors flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-marca)]"></span> Inicio
        </a>
        <a href="#servicios" class="mobile-link hover:text-[var(--color-marca)] transition-colors flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-marca)]"></span> Servicios
        </a>
        <a href="#metodo" class="mobile-link hover:text-[var(--color-marca)] transition-colors flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-marca)]"></span> Cómo Trabajamos
        </a>
        <a href="#faq" class="mobile-link hover:text-[var(--color-marca)] transition-colors flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-marca)]"></span> Preguntas Frecuentes
        </a>
      </div>

      {/* <-------- Botón CTA Móvil -------->*/}
      <Button href={wppLink} variant="whatsapp" target="_blank" rel="noopener noreferrer" class="w-full">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
        WhatsApp Urgencias
      </Button>
      
    </nav>
  </div>
</header>

<script is:inline>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');
  const mobileLinks = document.querySelectorAll('.mobile-link'); // Seleccionamos los links móviles

  // <-------- Función para abrir/cerrar menú -------->
  const toggleMenu = () => {
    menu.classList.toggle('hidden');
    menu.classList.toggle('flex');
    iconOpen.classList.toggle('hidden');
    iconClose.classList.toggle('hidden');
  };

  // <--------Evento del botón hamburguesa -------->
  btn.addEventListener('click', toggleMenu);

  // <-------- Cerramos el menú automáticamente cuando se hace clic en un enlace -------->
  mobileLinks.forEach(link => {
    link.addEventListener('click', () => {
      // <-------- Solo cerramos si el menú está abierto -------->
      if (!menu.classList.contains('hidden')) {
        toggleMenu();
      }
    });
  });
</script>